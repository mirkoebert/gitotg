# Example for /etc/gitotg.env — the EnvironmentFile read by deploy/gitotg.service.
#
#   sudo cp gitotg.env.example /etc/gitotg.env
#   sudo vi /etc/gitotg.env          # fill in the real values
#   sudo chown root:root /etc/gitotg.env
#   sudo chmod 600 /etc/gitotg.env   # systemd reads this as root, before dropping to the gitotg user
#
# Then uncomment this line in /etc/systemd/system/gitotg.service:
#   EnvironmentFile=/etc/gitotg.env
# followed by: sudo systemctl daemon-reload && sudo systemctl restart gitotg
#
# Format is KEY=VALUE, one per line. systemd does NOT run a shell here: no $VAR expansion,
# no command substitution, and quotes become part of the value unless the whole value is quoted.
# Never commit the filled-in file.

# --- OAuth credentials (required — the app will not start without them) -------------------
# Note the asymmetric naming: the Google pair has no provider prefix. That is what
# src/main/resources/application.yaml refers to, so keep the names exactly as they are.

# Google Cloud console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
CLIENT_ID=000000000000-example.apps.googleusercontent.com
CLIENT_SECRET=replace-me

# GitHub -> Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=Iv1.replaceme
GITHUB_CLIENT_SECRET=replace-me

# Authorized redirect URI to register with BOTH providers (the app derives it from the
# request base URL, so it must match the public origin exactly):
#   https://your.domain/login/oauth2/code/google
#   https://your.domain/login/oauth2/code/github

# --- Optional overrides -------------------------------------------------------------------
# Any Spring property can be set here via relaxed binding: lower-case dots and dashes become
# upper-case underscores, e.g. server.port -> SERVER_PORT.

# The H2 file database ships with a default password in application.yaml. Override it on a
# real host, and remember the existing ./db/gitotgdb file keeps the password it was created
# with — changing this on an existing database locks the app out of it.
#SPRING_DATASOURCE_PASSWORD=replace-me

# Port 80 needs CAP_NET_BIND_SERVICE (already granted in the unit file). Set a high port
# instead if you put nginx or caddy in front.
#SERVER_PORT=8080

#LOGGING_LEVEL_COM_MIRKOEBERT=DEBUG
